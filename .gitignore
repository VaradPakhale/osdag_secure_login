# ============================================
# Rename this file to  .gitignore  (with the leading dot)
# ============================================

# Secrets — NEVER commit these
.env
.env.local
.env.*.local
*.pem
*.key

# Dependencies
node_modules/
.pnp/
.pnp.js

# Python (if you use FastAPI/Flask instead of Express)
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/

# Build output
dist/
build/
*.tsbuildinfo

# Logs
logs/
*.log
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# Test / coverage output
coverage/
.nyc_output/
test-results/

# Databases and uploads
*.sqlite
*.sqlite3
*.db
pgdata/
uploads/
storage/

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Editors
.vscode/
.idea/
*.swp

# Claude Code local state (keep CLAUDE.md itself — that IS committed)
.claude/
INTERVIEW_NOTES.md
