# ---------------------------------------------------------------------------
# Copy to .env and fill in.   cp .env.example .env
# PLACEHOLDERS ONLY — never commit a real API key or encryption key.
# .env and .env.local are gitignored; this file is committed.
#
# Two supported paths (DECISIONS.md ADR-0017):
#
#   A. APPWRITE CLOUD  (default, recommended) — nothing to install.
#      Create a project + API key in the console, fill this file in, then:
#          npm run setup && npm run dev
#
#   B. SELF-HOSTED     (no account needed, ~23 containers, ~1.4 GB RAM)
#          npm run bootstrap     # writes .env.local with real values
#          npm run setup && npm run dev
#      You can leave this file's Appwrite entries at their placeholders.
#
# PRECEDENCE: exported environment  >  .env.local  >  .env
# So a stale .env.local from a previous `bootstrap` run beats this file. If you
# switch from self-hosted to Cloud, DELETE .env.local or you will keep talking
# to the local instance.
# ---------------------------------------------------------------------------

# 3001, not 3000, so this and custom-backend can run side by side. The reviewer
# switches between them by editing the client's Base URL field to
# http://localhost:3001 — that is usage, not a change to index.html.
PORT=3001

# =========================== PATH A — APPWRITE CLOUD =========================
#
# Console steps (about two minutes):
#   1. Sign in at https://cloud.appwrite.io and create a project.
#   2. Copy its Project ID from Settings, and the API Endpoint shown there —
#      Cloud is regional, so yours may be https://fra.cloud.appwrite.io/v1
#      rather than the generic host below. Use exactly what the console shows.
#   3. Overview -> Integrations -> API Keys -> Create API key.
#      Enable these scopes (the console selects NONE by default):
#        users.read users.write
#        databases.read databases.write
#        collections.read collections.write
#        attributes.read attributes.write
#        indexes.read indexes.write
#        documents.read documents.write
#        files.read files.write
#        buckets.read buckets.write
#        sessions.write
#   4. Paste the key secret below. It is shown once.
#
# Everything after that is scripted: `npm run setup` creates the database,
# collection, attributes, indexes, bucket and permissions, then seeds.

APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=YOUR_PROJECT_ID
APPWRITE_API_KEY=YOUR_API_KEY

# ======================= PATH B — SELF-HOSTED (alternative) ==================
#
# Requires Docker with roughly 4 GB free RAM: the stack is ~23 containers using
# ~1.4 GB at idle, and ~7.5 GB of images to download on first run. Budget
# 10-20 minutes for that download; it is the slow part, and it is one-off.
#
#   mkdir appwrite && cd appwrite
#   docker run -it --rm \
#     --volume /var/run/docker.sock:/var/run/docker.sock \
#     --volume "$(pwd)":/usr/src/code/appwrite:rw \
#     --entrypoint="install" appwrite/appwrite:1.6.2
#   cd .. && npm run bootstrap
#
# Then set:  APPWRITE_ENDPOINT=http://localhost/v1
# (`npm run bootstrap` writes this into .env.local for you.)

# --- resource ids (both paths; `npm run provision` creates them) ------------
APPWRITE_DATABASE_ID=osdag
APPWRITE_FILES_COLLECTION_ID=files
APPWRITE_SESSIONS_COLLECTION_ID=facade_sessions
APPWRITE_ATTEMPTS_COLLECTION_ID=facade_login_attempts
APPWRITE_BUCKET_ID=user-files

# --- facade sessions -------------------------------------------------------
# REQUIRED, with NO fallback anywhere in the code — the server refuses to start
# without it, exactly as custom-backend refuses without DATABASE_URL. It
# encrypts the Appwrite session secret at rest (AES-256-GCM), so a leaked
# database does not hand over every live session. Must decode to 32 bytes.
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# (`npm run bootstrap` generates one automatically for the self-hosted path.)
SESSION_ENCRYPTION_KEY=REPLACE_ME_WITH_32_RANDOM_BYTES_BASE64

# Absolute expiry, never extended. Matches custom-backend and the mock.
SESSION_TTL_MINUTES=30

# --- CORS ------------------------------------------------------------------
# '*' reflects whatever Origin shows up — fine locally, wrong in production.
CORS_ALLOWED_ORIGINS=*

# --- cookie alias ----------------------------------------------------------
COOKIE_NAME=session
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# --- login rate limiting (R5.3) --------------------------------------------
# OURS, not Appwrite's — see README for where Appwrite's own limits sit
# relative to these. Keyed on email first, because every account in a local
# review shares ::1. See DECISIONS.md ADR-0006.
#
# LOCKED OUT MID-REVIEW? Restarting does NOT clear it — counters live in
# Appwrite on purpose. Run:
#   npm run reset-lockout                      # all counters
#   npm run reset-lockout -- bob@example.com   # just one address
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
LOGIN_RATE_LIMIT_IP_MAX=50
LOGIN_RATE_LIMIT_IP_WINDOW_MINUTES=15

# --- self-hosted bootstrap only --------------------------------------------
# Throwaway console credentials `npm run bootstrap` creates on a LOCAL
# instance. Not used on the Cloud path.
APPWRITE_CONSOLE_EMAIL=admin@example.com
APPWRITE_CONSOLE_PASSWORD=ConsolePassword123!
