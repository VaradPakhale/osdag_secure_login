# ---------------------------------------------------------------------------
# Copy to .env and fill in.   cp .env.example .env
# PLACEHOLDERS ONLY — never commit a real API key or encryption key.
# .env and .env.local are gitignored; this file is committed.
#
# For a LOCAL Appwrite, `npm run bootstrap` writes .env.local with real values
# and you can leave this file's Appwrite entries alone.
# For Appwrite Cloud, paste your own values here.
# ---------------------------------------------------------------------------

# 3001, not 3000, so this and custom-backend can run side by side. The reviewer
# switches between them by editing the client's Base URL field to
# http://localhost:3001 — that is usage, not a change to index.html.
PORT=3001

# --- Appwrite connection ---------------------------------------------------
# Self-hosted default. Appwrite Cloud is https://cloud.appwrite.io/v1
APPWRITE_ENDPOINT=http://localhost/v1

# REQUIRED. From the Appwrite console, or created by `npm run bootstrap`.
APPWRITE_PROJECT_ID=YOUR_PROJECT_ID

# REQUIRED. Server API key. This is effectively root on the project — it
# bypasses every document and file permission. It is used for provisioning and
# registration ONLY; see src/lib/appwrite.js and DECISIONS.md ADR-0002.
APPWRITE_API_KEY=YOUR_API_KEY

# Resource ids. `npm run provision` creates all of these.
APPWRITE_DATABASE_ID=osdag
APPWRITE_FILES_COLLECTION_ID=files
APPWRITE_SESSIONS_COLLECTION_ID=facade_sessions
APPWRITE_ATTEMPTS_COLLECTION_ID=facade_login_attempts
APPWRITE_BUCKET_ID=user-files

# --- facade sessions -------------------------------------------------------
# REQUIRED. Encrypts the Appwrite session secret at rest (AES-256-GCM), so a
# leaked database does not hand over every live session. Must be 32 bytes,
# base64. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_ENCRYPTION_KEY=REPLACE_ME_WITH_32_RANDOM_BYTES_BASE64

# Absolute expiry, never extended. Matches custom-backend and the mock.
SESSION_TTL_MINUTES=30

# --- CORS ------------------------------------------------------------------
# '*' reflects whatever Origin shows up — fine locally, wrong in production.
CORS_ALLOWED_ORIGINS=*

# --- cookie alias ----------------------------------------------------------
COOKIE_NAME=session
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# --- login rate limiting (R5.3) --------------------------------------------
# OUR requirement, not Appwrite's — see README for where Appwrite's own limits
# sit relative to these. Keyed on email first, because every account in a local
# review shares ::1. See DECISIONS.md ADR-0006.
#
# LOCKED OUT MID-REVIEW? Restarting does NOT clear it — counters live in
# Appwrite on purpose. Run:
#   npm run reset-lockout                      # all counters
#   npm run reset-lockout -- bob@example.com   # just one address
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
LOGIN_RATE_LIMIT_IP_MAX=50
LOGIN_RATE_LIMIT_IP_WINDOW_MINUTES=15

# --- bootstrap-only (local Appwrite) ---------------------------------------
# Console account `npm run bootstrap` creates. Throwaway dev credentials.
APPWRITE_CONSOLE_EMAIL=admin@example.com
APPWRITE_CONSOLE_PASSWORD=ConsolePassword123!
