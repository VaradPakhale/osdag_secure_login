# ---------------------------------------------------------------------------
# Copy to .env and adjust.  cp .env.example .env
# .env is gitignored; .env.example is committed. Never put a real secret here.
# ---------------------------------------------------------------------------

# REQUIRED. No default — the app refuses to start without it, deliberately:
# a hardcoded fallback is how a dev database quietly becomes the production one.
# This value matches the bundled docker-compose.yml.
DATABASE_URL=postgres://osdag:osdag_dev_password@localhost:5432/osdag_auth

# The client's Base URL field defaults to http://localhost:3000
# (web/index.html:31), so changing this means changing it there too.
PORT=3000

# --- sessions --------------------------------------------------------------
# Absolute expiry, never extended. 30 min mirrors the mock's SESSION_TTL_MS
# (web/mock-api.js:30).
SESSION_TTL_MINUTES=30

# --- CORS ------------------------------------------------------------------
# '*' reflects whatever Origin shows up — convenient for local review, wrong
# for anything real. Set a comma-separated allowlist in production, e.g.
#   CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
CORS_ALLOWED_ORIGINS=*

# --- cookie alias ----------------------------------------------------------
# Bearer is the contract; the cookie exists so the client's "Backend uses
# cookie sessions" checkbox (web/index.html:32) resolves to the same session
# row rather than dead-ending. See DECISIONS.md ADR-0001.
COOKIE_NAME=session
COOKIE_SECURE=false
# 'lax' works when the page and the API share a hostname (localhost:5500 ->
# localhost:3000 is same-site; ports are not part of the site). If you serve
# the client from a DIFFERENT host than the API — 127.0.0.1 vs localhost
# counts — the browser will drop the cookie unless you set:
#   COOKIE_SAMESITE=none
#   COOKIE_SECURE=true      (and serve over HTTPS; http://localhost is exempt)
COOKIE_SAMESITE=lax

# --- login rate limiting / lockout (R5.3) ----------------------------------
# Primary key is the email address, not the IP: every account in this review
# shares ::1, so IP-only keying would let a lockout test on one user block the
# other two. See DECISIONS.md ADR-0006.
#
# LOCKED OUT MID-REVIEW? Restarting does NOT clear it — the counter is in the
# database on purpose. Run either of:
#   npm run reset-lockout                     (all counters; leaves users/files alone)
#   npm run reset-lockout -- bob@example.com  (just one address)
#   npm run seed                              (also clears counters, but re-seeds)
# The reset script talks to Postgres through the app's own pool, so it does not
# need `psql` installed — which it usually is not when Postgres runs in Docker.
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15

# Secondary, looser, per-IP backstop against password spraying across many
# addresses — which the per-email counter cannot see.
LOGIN_RATE_LIMIT_IP_MAX=50
LOGIN_RATE_LIMIT_IP_WINDOW_MINUTES=15

# --- storage ---------------------------------------------------------------
# Relative paths resolve against custom-backend/. Holds the seeded file blobs.
STORAGE_DIR=storage

# --- argon2id (R5.1) -------------------------------------------------------
# Defaults are the OWASP Password Storage Cheat Sheet argon2id row.
# Lower them only if a slow machine makes the review painful; never in production.
ARGON2_MEMORY_COST_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1
